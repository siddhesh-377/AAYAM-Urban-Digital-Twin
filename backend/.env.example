# ====================================================================
# AERIS — Urban Environmental Digital Twin (Pune)
# Environment Variables Configuration
# ====================================================================
# Copy this file to .env and fill in your keys.
# NEVER commit your real .env file to version control.

# ── Supabase & PostgreSQL (PostGIS) ──────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Never expose the service role key to frontend client applications:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostgreSQL connection string with PostGIS enabled:
# e.g., postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Leave blank or use sqlite for local offline fallback:
DATABASE_URL=sqlite:///./urban_twin.db

# ── External APIs ────────────────────────────────────────────────────
# OpenAQ API v3 Key (https://api.openaq.gov/)
OPENAQ_API_KEY=your_openaq_api_key_here

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# MapTiler API Key (https://www.maptiler.com/)
MAPTILER_API_KEY=your_maptiler_api_key_here

# TomTom Traffic API Key (optional - https://developer.tomtom.com/)
TOMTOM_API_KEY=

# ── Frontend & Application Ports ─────────────────────────────────────
# Allowed origin for CORS
FRONTEND_URL=http://localhost:3000
BACKEND_PORT=8000
APP_MODE=demo
ENVIRONMENT=development
