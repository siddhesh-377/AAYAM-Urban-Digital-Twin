# ====================================================================
# AERIS — Urban Environmental Digital Twin (Pune)
# Root Environment Variables Configuration
# ====================================================================

# ── Supabase & PostgreSQL (PostGIS) ──────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── External Data & Model APIs ───────────────────────────────────────
OPENAQ_API_KEY=
GEMINI_API_KEY=
MAPTILER_API_KEY=
VITE_MAPTILER_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

# ── Database Connection ──────────────────────────────────────────────
# PostgreSQL + PostGIS or local SQLite:
DATABASE_URL=sqlite:///./urban_twin.db

# ── Application Endpoints ────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_PORT=8000
APP_MODE=demo
ENVIRONMENT=development
NEXT_PUBLIC_API_URL=http://localhost:8000
